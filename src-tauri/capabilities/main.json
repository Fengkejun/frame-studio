{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local main window can edit projects and invoke the native text workflow engine. No raw filesystem or shell access.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-workflows",
    "allow-save-workflow",
    "allow-list-providers",
    "allow-save-provider",
    "allow-remove-provider",
    "allow-test-provider",
    "allow-list-runs",
    "allow-get-run",
    "allow-start-run",
    "allow-cancel-run",
    "allow-validate-artifact",
    "allow-import-image",
    "allow-list-image-assets",
    "allow-image-preview",
    "allow-select-first-frame",
    "allow-list-first-frames",
    "allow-test-comfy",
    "allow-image-settings",
    "allow-list-image-jobs",
    "allow-start-image-job",
    "allow-resume-image-job",
    "allow-pause-image-job",
    "allow-cloud-image-key-status",
    "allow-save-cloud-image-key",
    "allow-clear-cloud-image-key",
    "allow-list-cloud-image-jobs",
    "allow-start-cloud-image-job"
  ]
}
